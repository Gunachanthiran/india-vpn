APP_NAME=India WireGuard VPN API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./india_vpn.db
JWT_SECRET_KEY=dev-secret-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Compliance: "private" (no connection history logs) or "cert_in_audit" (5-year CERT-In 2022 audit logs)
COMPLIANCE_MODE=private
CERT_IN_RETENTION_DAYS=1825

# WireGuard driver: "mock" (in-memory/DB only, ideal on Windows/dev) or "wg_quick" (syncs live Linux wg0)
WG_DRIVER=mock
WG_INTERFACE=wg0
WG_DEFAULT_MTU=1420
WG_DEFAULT_DNS=1.1.1.1,9.9.9.9
WG_PERSISTENT_KEEPALIVE=25

# Seeding
SEED_DEFAULT_SERVERS=true
ADMIN_EMAIL=admin@indiavpn.example.com
ADMIN_PASSWORD=ChangeMe123!
